#!/usr/bin/env bash
# Codex launcher for Hugging Face Inference Providers with model/provider selection.
# Auth: uses $HF_TOKEN if set, else the token saved by `hf auth login`.
# fzf is used for selection when available, with an arrow-key menu fallback.

set -euo pipefail

# Parse wrapper flags, forwarding everything else to `codex`.
#   --bill-to <org> / --bill-to=<org>  bill inference to a HF org (X-HF-Bill-To)
# Falls back to $HF_BILL_TO when the flag is absent.
BILL_TO="${HF_BILL_TO:-}"
CODEX_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) exec codex --help ;;
    --bill-to)
      BILL_TO="${2:-}"
      if [[ -z "$BILL_TO" ]]; then
        echo "Error: --bill-to requires an organization name." >&2
        exit 1
      fi
      shift 2
      ;;
    --bill-to=*) BILL_TO="${1#*=}"; shift ;;
    *) CODEX_ARGS+=("$1"); shift ;;
  esac
done

HF_TOKEN="${HF_TOKEN:-}"

# Fall back to the token saved by `hf auth login` when HF_TOKEN isn't set.
# `hf auth token` prints the active token and honors `hf auth switch`.
if [[ -z "$HF_TOKEN" ]] && command -v hf >/dev/null 2>&1; then
  HF_TOKEN="$(hf auth token 2>/dev/null || true)"
fi

if [[ -z "$HF_TOKEN" ]]; then
  echo "Error: no Hugging Face token found." >&2
  echo "Log in with:        hf auth login" >&2
  echo "or export a token:  export HF_TOKEN='hf_...'" >&2
  exit 1
fi

for cmd in curl jq codex; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Error: '$cmd' is required but not found in PATH." >&2
    exit 1
  fi
done

# Codex home for this wrapper. Isolating CODEX_HOME keeps the user's own MCP
# servers / apps / plugins out of the request: Codex forwards those as
# `namespace`/`mcp` tool types that the HF router's Responses API rejects.
# $HF_HOME/hf-codex if HF_HOME is set, else $XDG_CACHE_HOME/huggingface/hf-codex,
# else ~/.cache/huggingface/hf-codex.
if [[ -n "${HF_HOME:-}" ]]; then
  CODEX_HOME_DIR="${HF_HOME}/hf-codex"
elif [[ -n "${XDG_CACHE_HOME:-}" ]]; then
  CODEX_HOME_DIR="${XDG_CACHE_HOME}/huggingface/hf-codex"
else
  CODEX_HOME_DIR="${HOME}/.cache/huggingface/hf-codex"
fi
CONFIG_FILE="${CODEX_HOME_DIR}/last-model.json"
CODEX_CONFIG="${CODEX_HOME_DIR}/config.toml"

# Pick one line from stdin. Uses fzf when installed; otherwise falls back to a
# pure-bash arrow-key menu so fzf stays optional.
pick() {
  local prompt="$1" header="$2"
  if command -v fzf >/dev/null 2>&1; then
    fzf --prompt="$prompt" --height=50% --reverse --header="$header"
    return
  fi
  _arrow_menu "$header"
}

# Arrow-key selection menu (no fzf needed). Reads candidate lines from stdin,
# draws a scrolling list on the terminal (stderr) starting at the top, and
# prints the chosen line to stdout. Up/Down or j/k move, g/G or Home/End jump
# to ends, Enter selects, q/Esc/Ctrl-C cancel (prints nothing).
_arrow_menu() {
  local header="$1"
  local items=() line
  while IFS= read -r line; do items+=("$line"); done
  set +e  # interactive reads/arithmetic below may "fail" benignly under set -e
  local n=${#items[@]}
  (( n == 0 )) && return 0
  if [[ ! -t 2 || ! -r /dev/tty ]]; then
    echo "no-fzf menu needs an interactive terminal; install fzf for selection" >&2
    return 0
  fi

  local size rows cols
  size=$(stty size </dev/tty 2>/dev/null)
  rows=${size%% *}; cols=${size##* }
  [[ $rows =~ ^[0-9]+$ ]] || rows=24
  [[ $cols =~ ^[0-9]+$ ]] || cols=80
  local vh=$(( rows - 4 )) maxw=$(( cols - 4 ))
  (( vh < 1 ))   && vh=1
  (( vh > n ))   && vh=$n
  (( maxw < 8 )) && maxw=8

  local saved; saved=$(stty -g </dev/tty 2>/dev/null)
  trap 'stty "$saved" </dev/tty 2>/dev/null; printf "\e[?25h" >&2' EXIT
  trap 'stty "$saved" </dev/tty 2>/dev/null; printf "\e[?25h\n" >&2; exit 130' INT TERM
  stty -echo -icanon </dev/tty 2>/dev/null
  printf '\e[?25l' >&2   # hide cursor

  local sel=0 top=0 drawn=0 key rest i disp buf
  while true; do
    (( sel < top ))       && top=$sel
    (( sel >= top + vh )) && top=$(( sel - vh + 1 ))
    buf=""
    (( drawn )) && buf+=$'\e['"$(( vh + 2 ))"'A'
    drawn=1
    buf+=$'\r\e[2K\e[1m'"$header"$'\e[0m\n'
    for (( i = top; i < top + vh; i++ )); do
      disp=${items[i]:0:maxw}
      if (( i == sel )); then
        buf+=$'\r\e[2K\e[7m> '"$disp"$' \e[0m\n'
      else
        buf+=$'\r\e[2K  '"$disp"$'\n'
      fi
    done
    buf+=$'\r\e[2K\e[2m'"  [$(( sel + 1 ))/$n]  up/down move - enter select - q quit"$'\e[0m\n'
    printf '%s' "$buf" >&2

    IFS= read -rsn1 key </dev/tty || { sel=-1; break; }
    if [[ $key == $'\e' ]]; then
      # integer timeout: macOS stock bash 3.2 rejects fractional -t
      read -rsn2 -t 1 rest </dev/tty
      case "$rest" in
        '[A') (( sel > 0 ))     && sel=$(( sel - 1 )) ;;
        '[B') (( sel < n - 1 )) && sel=$(( sel + 1 )) ;;
        '[H') sel=0 ;;
        '[F') sel=$(( n - 1 )) ;;
        '')   sel=-1; break ;;          # bare Esc = cancel
      esac
    else
      case "$key" in
        k) (( sel > 0 ))     && sel=$(( sel - 1 )) ;;
        j) (( sel < n - 1 )) && sel=$(( sel + 1 )) ;;
        g) sel=0 ;;
        G) sel=$(( n - 1 )) ;;
        q|Q)            sel=-1; break ;;
        ''|$'\n'|$'\r') break ;;        # Enter = select current
      esac
    fi
  done

  printf '\e[%dA\r\e[J' "$(( vh + 2 ))" >&2   # erase the menu block
  stty "$saved" </dev/tty 2>/dev/null
  printf '\e[?25h' >&2
  trap - EXIT INT TERM

  (( sel < 0 )) && return 0
  printf '%s\n' "${items[sel]}"
}

# Offer to reuse the last model saved in last-model.json; accepting skips the
# remote model listing (one HTTP call, ~300ms).
MODEL_STRING=""
if [[ -f "$CONFIG_FILE" && -r /dev/tty ]]; then
  LAST_MODEL="$(jq -r '.model // empty' "$CONFIG_FILE" 2>/dev/null || true)"
  if [[ -n "$LAST_MODEL" ]]; then
    printf 'Use last model %s? [Y/n] ' "$LAST_MODEL" >&2
    IFS= read -r answer </dev/tty || answer="n"
    case "$answer" in
      ''|y|Y|yes|Yes) MODEL_STRING="$LAST_MODEL" ;;
    esac
  fi
fi

if [[ -z "$MODEL_STRING" ]]; then
  MODEL_DATA="$(curl -fsS "https://router.huggingface.co/v1/models" \
    -H "Authorization: Bearer ${HF_TOKEN}")"

  MODEL="$(echo "$MODEL_DATA" | jq -r '.data[].id' \
    | pick "Model: " "Hugging Face Inference Providers - Select Model")"

  if [[ -z "$MODEL" ]]; then
    echo "No model selected"
    exit 1
  fi

  PROVIDER="$(
    {
      echo "auto"
      echo "$MODEL_DATA" | jq -r --arg model "$MODEL" '.data[] | select(.id == $model) | .providers[].provider'
    } | awk '!seen[$0]++' \
      | pick "Provider: " "Select Provider for ${MODEL} (auto = no suffix)"
  )"

  if [[ -z "$PROVIDER" ]]; then
    echo "No provider selected"
    exit 1
  fi

  if [[ "$PROVIDER" == "auto" ]]; then
    MODEL_STRING="$MODEL"
  else
    MODEL_STRING="${MODEL}:${PROVIDER}"
  fi

  # Remember the selection for next launch.
  mkdir -p "$CODEX_HOME_DIR"
  jq -n --arg model "$MODEL_STRING" '{model: $model}' > "$CONFIG_FILE"
fi

# Write the wrapper-managed Codex config. Points Codex at the HF router and
# disables features whose request payloads the router's Responses API rejects:
#  - web_search / agents (multi_agent): sent as `web_search`/`namespace` tool
#    types the router only accepts `function`/`mcp` for.
#  - enable_request_compression: the router 400s on zstd-encoded bodies.
mkdir -p "$CODEX_HOME_DIR"
cat > "$CODEX_CONFIG" <<'TOML'
model_provider = "hf"
web_search = "disabled"

[agents]
enabled = false

[features]
enable_request_compression = false

[model_providers.hf]
name = "Hugging Face"
base_url = "https://router.huggingface.co/v1"
env_key = "HF_TOKEN"
wire_api = "responses"
TOML

# Bill inference to a HF org via the router's X-HF-Bill-To header.
if [[ -n "$BILL_TO" ]]; then
  printf '\n[model_providers.hf.env_http_headers]\n"X-HF-Bill-To" = "HF_BILL_TO_HEADER"\n' >> "$CODEX_CONFIG"
  export HF_BILL_TO_HEADER="$BILL_TO"
  echo "→ billing to org: ${BILL_TO}" >&2
fi

echo "→ codex @ ${MODEL_STRING}" >&2

export HF_TOKEN
export CODEX_HOME="$CODEX_HOME_DIR"

if [[ -n "${HF_CODEX_DRY_RUN:-}" ]]; then
  printf '%q ' codex -c "model=\"${MODEL_STRING}\"" ${CODEX_ARGS[@]+"${CODEX_ARGS[@]}"}; echo
  exit 0
fi

exec codex -c "model=\"${MODEL_STRING}\"" ${CODEX_ARGS[@]+"${CODEX_ARGS[@]}"}
